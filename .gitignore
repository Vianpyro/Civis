# Generated by Cargo
# will have compiled files and executables
debug
target

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Generated by cargo mutants
# Contains mutation testing data
**/mutants.out*/

# RustRover
#  JetBrains specific template is maintained in a separate JetBrains.gitignore that can
#  be found at https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore
#  and can be added to the global gitignore or merged into this file.  For a more nuclear
#  option (not recommended) you can uncomment the following to ignore the entire idea folder.
#.idea/

# Fetched official documents. Rebuilt by `python -m pipeline.run --step fetch`;
# the committed .sha256 files are the durable record.
.cache/

# LLM question drafts, awaiting human review
review/

# Personal drafts. The only unversioned place under docs/ — every other
# document there is committed, including the temporary ones in docs/wip/:
# a working note whose deletion is not recoverable is a note that gets kept
# forever out of caution.
docs/scratch/

# Python
__pycache__/
*.pyc

# Node / Astro
node_modules/
web/dist/
.astro/

# Counter database — statistics only, never the product
*.sqlite3
*.sqlite3-wal
*.sqlite3-shm
