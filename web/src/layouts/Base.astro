---
import "../styles.css";
import { BUILD_DATE, CI_RUN_URL, COMMIT, REPO_URL, href } from "../lib/paths.js";
import { LANGS, T } from "../lib/ui.js";

const { lang, title, page } = Astro.props;
const t = T[lang];
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/* The site name alone when a page does not name itself: composing it with
        an identical title produced "Civis — Civis". */}
    <title>{title ? `${title} — ${t.title}` : t.title}</title>
    <meta name="description" content={t.tagline} />
  </head>
  <body>
    {/* Both labels used to be a language test written in the markup (D4). They
        are chrome like every other string of the frame, so they come from T and
        the frame no longer holds a translation of its own. */}
    <a class="skip-link" href="#main">{t.skipToContent}</a>
    <nav class="langs" aria-label={t.language}>
      {
        LANGS.map((code) => (
          <a href={href(`${code}/${page}`)} aria-current={code === lang ? "page" : undefined}>
            {code.toUpperCase()}
          </a>
        ))
      }
    </nav>
    <main id="main">
      <slot />
    </main>
    <footer class="version">
      <span>
        {COMMIT && BUILD_DATE ? t.version(COMMIT.slice(0, 7), BUILD_DATE) : t.versionLocal}
      </span>
      {/* The methodology, reachable from every page including the questionnaire.
          The label names no formation and the link opens nothing on hover: what
          the page holds stays on the page, and the questionnaire's bundle is
          untouched by it (INV-01). */}
      <a href={href(`${lang}/method/`)} aria-current={page === "method" ? "page" : undefined}>
        {t.methodology}
      </a>
      <a href={REPO_URL}>{t.repository}</a>
      {CI_RUN_URL && <a href={CI_RUN_URL}>{t.quoteCheck}</a>}
    </footer>
  </body>
</html>
