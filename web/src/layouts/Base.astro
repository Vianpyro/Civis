---
import "../styles.css";
import { href } from "../lib/paths.js";
import { LANGS, T } from "../lib/ui.js";

const { lang, title, page } = Astro.props;
const t = T[lang];
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} — {t.title}</title>
    <meta name="description" content={t.tagline} />
  </head>
  <body>
    <a class="skip-link" href="#main">{lang === "fr" ? "Aller au contenu" : "Skip to content"}</a>
    <nav class="langs" aria-label={lang === "fr" ? "Langue" : "Language"}>
      {
        LANGS.map((code) => (
          <a href={href(`${code}/${page}`)} aria-current={code === lang ? "true" : undefined}>
            {code.toUpperCase()}
          </a>
        ))
      }
    </nav>
    <main id="main">
      <slot />
    </main>
  </body>
</html>
