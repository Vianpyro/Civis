---
// One formation record of the ranking. Props only, and used by the results page
// alone: it carries program data, so the questionnaire must never reach it,
// directly or through another component (INV-01).
//
// Three sentences, all at the same size and in the same colour: the base travels
// with the measure, never in a note, never below it and never quietened (P4,
// INV-13). No percentage, no bar, and no rank marking of any kind — the order of
// the records is a reading convenience, not a verdict (DP-10).
//
// The coverage is a property of the corpus, so it is known at build and written
// here. The fraction and the confidence are what a passation decides, so they
// are the only parts the script writes, into elements that already exist.
//
// Hidden until the script has filled it: a record whose two sentences are empty
// would state nothing at all. A formation with nothing compared is revealed like
// the others, with the reason in place of the fraction (INV-14).
//
// The name of the formation is its own, read from content/ and never
// translated; it carries its language so that a screen reader in English does
// not pronounce it with English rules (DP-18, WCAG 3.1.2).
import { CORPUS_LANG } from "../lib/ui.js";

const { id, name, coverage } = Astro.props;
---

<div class="result" data-party={id} hidden>
  <h3 lang={CORPUS_LANG}>{name}</h3>
  <p class="fraction"></p>
  <p class="confidence"></p>
  <p class="coverage">{coverage}</p>
</div>
