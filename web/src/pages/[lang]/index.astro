---
// The blind questionnaire. It imports the questions file and nothing else:
// no programs, no positions, no party data reaches this page's bundle.
import Question from "../../components/Question.astro";
import Base from "../../layouts/Base.astro";
import questions from "../../../../content/questions/fr-2027.json";
import { API, href } from "../../lib/paths.js";
import { CHOICE_LABELS, LANGS, T, THEMES } from "../../lib/ui.js";

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
const t = T[lang];
const labels = CHOICE_LABELS[lang];
const themes = THEMES[lang];
const items = questions.questions;
---

<Base lang={lang} page="">
  <h1>{t.title}</h1>
  <p class="tagline">{t.tagline}</p>
  <p class="muted">{t.intro}</p>

  <form id="questionnaire" data-api={API} data-results={href(`${lang}/results/`)} data-lang={lang}>
    {
      items.map((question, index) => (
        <Question
          id={question.id}
          theme={themes[question.theme]}
          text={question.text[lang]}
          index={index}
          total={items.length}
          labels={labels}
          skipLabel={t.skip}
        />
      ))
    }

    {/* Before the action bar, not after it: an alert the submitting user cannot
        see is an alert only a screen reader gets. */}
    <p class="muted" id="warning" role="alert" tabindex="-1" hidden>{t.incomplete}</p>
    <div class="sticky">
      <p aria-live="polite" id="progress" class="muted">
        {t.progress(0, items.length)}
      </p>
      {
        API && (
          <label class="consent">
            <input type="checkbox" id="aggregate" checked />
            <span>{t.optout}</span>
          </label>
        )
      }
      <button type="submit">{t.submit}</button>
    </div>
    {API && <p class="muted consent-help">{t.optoutHelp}</p>}
  </form>
</Base>

<script>
  const form = document.getElementById("questionnaire");
  const progress = document.getElementById("progress");
  const warning = document.getElementById("warning");
  const { api, results, lang } = form.dataset;
  const total = form.querySelectorAll("fieldset.question").length;

  // Nothing is preselected, so an unanswered question is absent from FormData
  // rather than present with an empty value; "skip" is what puts the empty value
  // there. The aggregate checkbox has an id and no name, so it never enters.
  const answered = () => [...new FormData(form).entries()].filter(([, value]) => value !== "");

  form.addEventListener("change", () => {
    const done = answered().length;
    progress.textContent =
      lang === "fr"
        ? `${done} réponse${done > 1 ? "s" : ""} sur ${total}`
        : `${done} of ${total} answered`;
    if (done > 0) warning.hidden = true;
  });

  form.addEventListener("submit", (event) => {
    event.preventDefault();
    const entries = answered();
    if (entries.length === 0) {
      warning.hidden = false;
      warning.focus();
      return;
    }

    const scale = [-1, -0.5, 0, 0.5, 1];
    const answers = Object.fromEntries(entries.map(([id, value]) => [id, scale[Number(value)]]));

    // No counter service configured means no opt-in was ever offered, so there
    // is nothing to send and nothing to consent to.
    if (api && document.getElementById("aggregate")?.checked) {
      // One independent request per answer, in random order. Nothing on the wire
      // links them: no session, no id, no timestamp, and the server stores only
      // counters. ponytail: a shared source IP is still a correlation ceiling we
      // do not control from the client — a relay in front of the API is the exit.
      for (const [id, value] of entries.sort(() => Math.random() - 0.5)) {
        fetch(`${api}/counts`, {
          method: "POST",
          headers: { "content-type": "application/json" },
          body: JSON.stringify({ question: id, choice: Number(value) }),
          keepalive: true,
        }).catch(() => {});
      }
    }

    sessionStorage.setItem("civis:answers", JSON.stringify(answers));
    location.href = results;
  });
</script>
