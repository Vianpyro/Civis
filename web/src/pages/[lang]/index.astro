---
// The blind questionnaire. It imports the questions file and nothing else:
// no programs, no positions, no party data reaches this page's bundle.
import ClosingBlock from "../../components/ClosingBlock.astro";
import DraftNotice from "../../components/DraftNotice.astro";
import Question from "../../components/Question.astro";
import Base from "../../layouts/Base.astro";
import questions from "../../../../content/questions/fr-2027.json";
import { DRAFT_KEY, ORDER_KEY } from "../../lib/draft.js";
import { API, href } from "../../lib/paths.js";
import { CHOICE_LABELS, LANGS, T, THEMES, reading } from "../../lib/ui.js";

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
const t = T[lang];
const labels = CHOICE_LABELS[lang];
const themes = THEMES[lang];
const items = questions.questions;

// The header states how many formations the corpus covers (DP-27). Counted at
// build time from the file listing: the figure is read, never copied here (K9).
// The glob is left lazy and its loaders are never called, so no file under
// content/programs is opened and nothing of a formation — id, name or acronym —
// can reach this page (INV-01).
const formations = Object.keys(import.meta.glob("../../../../content/programs/fr-2027/*.json")).length;

// What one request carries, built here by the same expression as the send loop
// below and from a question identifier read from the corpus, never copied (K9).
// Answering that question at that rank and watching the network tab is the
// gesture that takes the exposure in the closing block apart (P1); a specimen
// written by hand could only be believed.
const payload = JSON.stringify({ question: items[0].id, choice: 3 });
---

<Base lang={lang} page="">
  <h1>{t.title}</h1>

  {/* The header (DP-27): one block, five statements in the fixed order, 120
      characters each at most. No lower-level heading, no illustration, no action
      button — the cap is what keeps it from growing back into a landing (DP-07).
      The link to the methodology page waits for PR-13: a link to a page that
      does not exist yet would be a dead link.

      The third statement is also where the register of everything below is
      declared, once for the thirty questions: they are one uniform context, and
      a marking repeated on each of them would be the noise that stops being
      read (System §3.7, C6). */}
  <div class="preamble">
    {t.header(items.length, formations).map((statement) => <p>{statement}</p>)}
    <noscript><p>{t.noscript}</p></noscript>
  </div>

  <script is:inline>
    // The draw below moves DOM nodes and has to land before the first visible
    // paint (DT-08). Hiding the questions here and showing them again in the
    // inline script that follows the form is what makes that verifiable: with
    // the HTML streaming over a slow link, the parser would otherwise paint the
    // first questions in file order while it waits for the rest.
    //
    // Without JavaScript the attribute is never set and the form renders exactly
    // as it was sent. No control is masked, restyled or replaced: the wrapper is
    // hidden for the duration of the parse and shown by the same pass (INV-10).
    document.documentElement.dataset.shuffling = "";
  </script>

  {/* The storage key and the property carrying the order travel from draft.js
      through the form: the draw below is an inline script and cannot import
      them, and a second copy of either name would be a copy that drifts. */}
  <form
    id="questionnaire"
    data-api={API}
    data-results={href(`${lang}/results/`)}
    data-draft={DRAFT_KEY}
    data-order={ORDER_KEY}
  >
    {/* Above the questions, outside the header block: the erasure control is an
        action, and DP-27 caps the header at five statements and one link. */}
    <DraftNotice restored={t.draftRestored} clear={t.draftClear} />

    {
      items.map((question, index) => (
        <Question
          id={question.id}
          theme={themes[question.theme]}
          {...reading(question.text, lang)}
          lang={lang}
          index={index}
          total={items.length}
          labels={labels}
          skipLabel={t.skip}
        />
      ))
    }

    {/* Before the action bar, not after it: an alert the submitting user cannot
        see is an alert only a screen reader gets. */}
    <p class="muted" id="warning" role="alert" tabindex="-1" hidden>{t.incomplete}</p>
    {/* Two elements, count and action (System §5.10). The contribution choice
        left this bar for the closing block below: a privacy decision taken at
        the exact moment of the click, away from its explanation, is the cookie
        banner pattern applied to the one place where candour is the argument. */}
    <div class="sticky">
      <p aria-live="polite" id="progress" class="muted">
        {t.progress(0, items.length)}
      </p>
      <button type="submit">{t.submit}</button>
    </div>

    {/* After the bar, so the bar comes to rest above it rather than over it.
        Nothing here without a counter service: no box, no block, no send. */}
    {
      API && (
        <ClosingBlock
          label={t.optout}
          refusal={t.optoutRefusal}
          sent={t.optoutSent}
          payload={payload}
          notSent={t.optoutNotSent}
          why={t.optoutWhy}
          ip={t.optoutIp}
          submit={t.submit}
        />
      )
    }
  </form>

  {/* The strings the client script writes, produced by T and handed over as
      data (DT-17). The counter is one string per possible count, so its
      pluralisation is stated once, in ui.js, and read here — the script used to
      rewrite the rule for want of access to the module (D2). */}
  <script
    type="application/json"
    id="strings"
    set:html={JSON.stringify({
      progress: Array.from({ length: items.length + 1 }, (_, done) => t.progress(done, items.length)),
    })}
  />

  <script is:inline>
    // Draw of the display order (DP-14). Inline and synchronous, right after the
    // questions it moves: it ships with the HTML instead of costing a request,
    // and it runs before the browser is free to paint what it has parsed.
    (() => {
      const form = document.getElementById("questionnaire");
      try {
        const questions = [...form.querySelectorAll("fieldset.question")];

        // A draft carries the order it was answered in (DT-09), and that order
        // is applied here, in place of a draw: a draw running afterwards would
        // overwrite it. Reading storage can throw — private browsing, storage
        // blocked — and the stored order can be stale; anything unusable falls
        // back to a draw, which is the questionnaire's normal behaviour.
        let drawn = null;
        try {
          const { draft, order } = form.dataset;
          const saved = JSON.parse(sessionStorage.getItem(draft) ?? "null")?.[order];
          if (Array.isArray(saved) && saved.length === questions.length) {
            const byId = new Map(
              questions.map((question) => [
                question.querySelector("input[type=radio]").name,
                question,
              ]),
            );
            const restored = saved.map((id) => byId.get(id));
            if (restored.every(Boolean)) drawn = restored;
          }
        } catch {
          /* No readable storage: the questionnaire works, without persistence. */
        }

        if (!drawn) {
          drawn = questions;
          // Fisher-Yates: every permutation equally likely. The counter loop uses a
          // random comparator for a different purpose; a comparator does not give a
          // uniform distribution and is not what draws the order here.
          for (let i = drawn.length - 1; i > 0; i -= 1) {
            const j = Math.floor(Math.random() * (i + 1));
            [drawn[i], drawn[j]] = [drawn[j], drawn[i]];
          }
        }

        // The nodes are moved, never reordered by a layout property: document
        // order stays the order on screen, and so does the tab order (INV-17).
        // Markers are rewritten after the move, so what is shown as "n / 30" is
        // the position on screen (DP-14). The draw stays in this tab: it is not
        // stored and never reaches the API (INV-03).
        const anchor = document.getElementById("warning");
        drawn.forEach((question, index) => {
          form.insertBefore(question, anchor);
          question.querySelector(".position").textContent = `${index + 1} / ${drawn.length}`;
        });
      } finally {
        delete document.documentElement.dataset.shuffling;
      }
    })();
  </script>
</Base>

<script>
  import { DRAFT_KEY, fromDraft, toDraft } from "../../lib/draft.js";
  import { CHOICES, choiceIndex } from "../../lib/score.js";

  const form = document.getElementById("questionnaire");
  const progress = document.getElementById("progress");
  const warning = document.getElementById("warning");
  const notice = document.getElementById("draft-restored");
  const { api, results } = form.dataset;
  const { progress: counts } = JSON.parse(document.getElementById("strings").textContent);
  const questions = [...form.querySelectorAll("fieldset.question")];
  const total = questions.length;

  // The order on screen — drawn or restored, settled by the inline script above,
  // which runs while the document parses and therefore before this module.
  const order = questions.map((question) => question.querySelector("input[type=radio]").name);

  // Nothing is preselected, so an unanswered question is absent from FormData
  // rather than present with an empty value; "skip" is what puts the empty value
  // there. The aggregate checkbox has an id and no name, so it never enters.
  const answered = () => [...new FormData(form).entries()].filter(([, value]) => value !== "");

  // The scale lives in score.js and nowhere else (DT-18): the form stores the
  // index of a choice, the draft and the results page store its value.
  const values = (entries) =>
    Object.fromEntries(entries.map(([id, value]) => [id, CHOICES[Number(value)]]));

  // Storage may be unavailable — private browsing, storage blocked. Every access
  // goes through here, so what a refusal costs is the draft and nothing else.
  const withStorage = (use) => {
    try {
      return use(sessionStorage);
    } catch {
      return null;
    }
  };

  // One string per possible count, written by T.progress at build time: the
  // plural rule lives in ui.js and is no longer restated here (D2).
  const count = (done) => {
    progress.textContent = counts[done];
    if (done > 0) warning.hidden = true;
  };

  // Restoring what the user actually answered, never a preselection (DP-25):
  // the notice below is what tells the two situations apart.
  const draft = withStorage((store) => fromDraft(JSON.parse(store.getItem(DRAFT_KEY) ?? "null")));
  let restored = 0;
  for (const [id, value] of Object.entries(draft?.answers ?? {})) {
    const choice = choiceIndex(value); // -1 for anything off the scale
    const input =
      choice < 0 ? null : form.querySelector(`input[name="${CSS.escape(id)}"][value="${choice}"]`);
    if (input) {
      input.checked = true;
      restored += 1;
    }
  }

  // Only when a restoration actually happened. Nothing to restore is the normal
  // state of a new session, not an absence to report (INV-14).
  if (restored > 0) {
    notice.hidden = false;
    count(restored);
  }

  document.getElementById("draft-clear").addEventListener("click", () => {
    // The radios only: the contribution checkbox is a privacy choice of its own
    // and erasing answers is not a reason to take it back to its default.
    for (const input of form.querySelectorAll("input[type=radio]")) input.checked = false;
    withStorage((store) => store.removeItem(DRAFT_KEY));
    notice.hidden = true;
    count(0);
  });

  form.addEventListener("change", () => {
    const entries = answered();
    count(entries.length);
    // Written on every change, with the order (DT-09). An empty questionnaire
    // holds no draft: it would restore nothing and would raise the notice over
    // an empty form.
    withStorage((store) =>
      entries.length > 0
        ? store.setItem(DRAFT_KEY, JSON.stringify(toDraft(values(entries), order)))
        : store.removeItem(DRAFT_KEY),
    );
  });

  form.addEventListener("submit", (event) => {
    event.preventDefault();
    const entries = answered();
    if (entries.length === 0) {
      warning.hidden = false;
      warning.focus();
      return;
    }

    const answers = values(entries);

    // No counter service configured means no opt-in was ever offered, so there
    // is nothing to send and nothing to consent to.
    if (api && document.getElementById("aggregate")?.checked) {
      // One independent request per answer, in random order. Nothing on the wire
      // links them: no session, no id, no timestamp, and the server stores only
      // counters. ponytail: a shared source IP is still a correlation ceiling we
      // do not control from the client — a relay in front of the API is the exit.
      for (const [id, value] of entries.sort(() => Math.random() - 0.5)) {
        fetch(`${api}/counts`, {
          method: "POST",
          headers: { "content-type": "application/json" },
          body: JSON.stringify({ question: id, choice: Number(value) }),
          keepalive: true,
        }).catch(() => {});
      }
    }

    // The payload the results page reads, written without the order: dropping
    // the order is what erases the draft (DP-09, condition 4). Written over,
    // never removed first — clearing the key here would destroy the payload it
    // is about to hand over. A blocked storage costs the results page its input,
    // exactly as it did before the draft existed.
    withStorage((store) => store.setItem(DRAFT_KEY, JSON.stringify(answers)));
    location.href = results;
  });
</script>
