---
// The methodology. Six facts the repository states in writing and the site
// never told anyone: the documents are from 2024, the drafts are generated by a
// language model before human review, part of the analyses of consequences is
// deduced and verified by nothing, the coverage of the formations is
// unbalanced, the counter server sees an IP address, and the aggregate sample is
// self-selected. Candour towards whoever reads the code and silence towards
// everyone else is the two-tier honesty P10 forbids.
//
// Documentation, not a landing (DP-07): no lead, no action button, nothing the
// project says about its own qualities. The limits are second, not last — a
// defect stated by the instrument is a documented characteristic, the same
// defect found by a reader is a proof of duplicity (P5).
//
// Nothing here is copied. The coverage figures are computed from the corpus at
// build, the confidence bounds and the percentage threshold are read from
// score.js, the fingerprints from content/. A threshold or a count restated in
// this file would drift from what the product applies, and this is precisely the
// page that would then be asserting a rule the code does not follow (K9, D7).
import Source from "../../components/Source.astro";
import Base from "../../layouts/Base.astro";
import questions from "../../../../content/questions/fr-2027.json";
import positions from "../../../../content/questions/fr-2027.positions.json";
import ensemble from "../../../../content/programs/fr-2027/ensemble.json";
import lr from "../../../../content/programs/fr-2027/lr.json";
import nfp from "../../../../content/programs/fr-2027/nfp.json";
import rn from "../../../../content/programs/fr-2027/rn.json";
import sources from "../../../../content/sources/fr-2027/sources.json";
import { CONFIDENCE_LEVELS, PERCENT_MIN_RESPONSES, coverage } from "../../lib/score.js";
import {
  CHOICE_LABELS,
  CHOICE_LABELS_SHORT,
  CONFIDENCE_LABELS,
  CORPUS_LANG,
  LANGS,
  T,
} from "../../lib/ui.js";

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
const t = T[lang];

const programs = [ensemble, lr, nfp, rn];
const total = questions.questions.length;

// Point identifier to formation, the one link content/ does not state directly.
// Coverage then comes from the same function the results page calls, so the two
// pages cannot disagree about a figure they both publish (DT-18, K9).
const partyOf = Object.fromEntries(
  programs.flatMap((program) => program.points.map((point) => [point.id, program.party.id])),
);
const scoreInput = Object.fromEntries(
  Object.entries(positions).map(([id, entries]) => [
    id,
    entries.map((entry) => ({ party: partyOf[entry.point], stance: entry.stance })),
  ]),
);
const covered = coverage(scoreInput);

// Distinct formations, not entries: a question holding two proposals of the same
// formation would still be a single-formation question.
const singleParty = Object.values(scoreInput).filter(
  (entries) => new Set(entries.map((entry) => entry.party)).size === 1,
).length;

// Fingerprints read from content/, never copied into web/ (INV-07, DT-12). Each
// file holds `<digest>  <url>`; the url is paired back against the source record,
// so a file attesting another document fails the build instead of being shown
// under the wrong title.
const digestFiles = import.meta.glob("../../../../content/sources/fr-2027/*.sha256", {
  query: "?raw",
  import: "default",
  eager: true,
});
const digests = Object.fromEntries(
  Object.entries(digestFiles).map(([path, text]) => [
    path.split("/").pop().replace(".sha256", ""),
    text.trim().split(/\s+/),
  ]),
);
const provenance = sources.map((source) => {
  const [digest, url] = digests[source.id] ?? [];
  if (url !== source.url) {
    throw new Error(`fingerprint for ${source.id} attests ${url ?? "nothing"}, not ${source.url}`);
  }
  return { source, digest };
});

// The scale in both of its forms (DP-26), and the confidence table built from
// the bounds themselves: the range wording is a function of min and max, so no
// bound is ever written outside score.js.
const scale = CHOICE_LABELS[lang].map((full, i) => ({
  displayed: CHOICE_LABELS_SHORT[lang][i],
  accessible: full,
}));
const confidences = CONFIDENCE_LEVELS.map(({ level, min, max }) => ({
  range: t.methodConfidenceRange(min, max),
  label: CONFIDENCE_LABELS[lang][level],
}));
---

<Base lang={lang} page="method" title={t.methodology}>
  {/* One register for the whole page, declared once and not repeated on every
      block: everything below is our commentary, and nothing on this page is a
      quotation. A marking repeated section after section stops being read
      (System §3.7, C6). */}
  <div class="method">
    <h1>{t.methodology}</h1>
    <p>{t.methodIntro}</p>

    <h2>{t.methodLimits}</h2>
    <p>{t.methodSingleParty(singleParty, total)}</p>

    <table>
      <caption>{t.methodCoverageTitle}</caption>
      <thead>
        <tr>
          <th scope="col">{t.methodCoverageColumn}</th>
          <th scope="col">{t.methodCoverageCount}</th>
        </tr>
      </thead>
      <tbody>
        {
          programs.map((program) => (
            <tr>
              {/* The name is the formation's own, never translated, so it
                  carries the language it is written in (DP-18, WCAG 3.1.2). */}
              <th scope="row" lang={CORPUS_LANG}>
                {program.party.name}
              </th>
              <td>{t.methodCoverageValue(covered[program.party.id] ?? 0, total)}</td>
            </tr>
          ))
        }
      </tbody>
    </table>

    <p>{t.methodCoverageNote}</p>

    {/* Two of these six sentences are the ones the closing block and the
        counters already carry, read from ui.js rather than written again: the
        limit stated here and the limit stated there are the same limit (K5).

        The analyses sit second and not last (DP-38): they are the one limit of
        this list that bears on what the results page displays rather than on
        how the corpus was gathered, and a limit placed at the bottom is a limit
        arranged to be read last. No bound of DP-33 is written in it — the caps
        live in the linter, and this page never restates a value the code holds
        (INV-13). */}
    <ul>
      {
        [
          t.methodLimitsDating,
          t.methodLimitsAnalyses,
          t.aggregateSample,
          t.optoutIp,
          t.methodLimitsFetchDate,
          t.methodLimitsVersioning,
        ].map((limit) => <li>{limit}</li>)
      }
    </ul>

    <h2>{t.methodCorpus}</h2>
    <p>{t.methodCorpusIntro(total, programs.length)}</p>

    {/* The same documents the results page lists, in the same apparatus register
        and from the same files — read twice, copied never (DP-28, INV-07). */}
    <ul class="provenance">
      {
        provenance.map(({ source, digest }) => (
          <li>
            <Source source={source} label={t.sourceLabel} />
            <span>{source.published ? t.published(source.published) : t.publishedUnknown}</span>
            <span>{t.fingerprint}</span>
            <code>{digest}</code>
          </li>
        ))
      }
    </ul>

    <p>{t.methodCorpusCheck}</p>

    <h2>{t.methodStatements}</h2>
    <p>{t.methodStatementsEditorial}</p>

    <h2>{t.methodModel}</h2>
    {/* The four facts in the order DP-17 fixes, the most alarming first, plus
        the two DP-38 adds for the analyses. The order is normative: reversed,
        the disclosure would read as its own justification, and appending the
        two new ones at the end would have been that reversal by another route.
        No mitigating formula anywhere in them. */}
    <ol>
      {t.methodModelFacts.map((fact) => <li>{fact}</li>)}
    </ol>

    <h2>{t.methodPassation}</h2>
    <p>{t.methodOrder}</p>
    <p>{t.methodLabels}</p>

    <table>
      <thead>
        <tr>
          <th scope="col">{t.methodLabelDisplayed}</th>
          <th scope="col">{t.methodLabelAccessible}</th>
        </tr>
      </thead>
      <tbody>
        {
          scale.map(({ displayed, accessible }) => (
            <tr>
              <th scope="row">{displayed}</th>
              <td>{accessible}</td>
            </tr>
          ))
        }
      </tbody>
    </table>

    <p>{t.methodNeutral}</p>

    <h2>{t.methodCalculation}</h2>
    <p>{t.methodFraction}</p>
    <p>{t.methodBase}</p>
    <p>{t.methodCoverageDefinition}</p>
    <p>{t.methodConfidence}</p>

    <table>
      <thead>
        <tr>
          <th scope="col">{t.methodConfidenceBase}</th>
          <th scope="col">{t.methodConfidenceLevel}</th>
        </tr>
      </thead>
      <tbody>
        {
          confidences.map(({ range, label }) => (
            <tr>
              <th scope="row">{range}</th>
              <td>{label}</td>
            </tr>
          ))
        }
      </tbody>
    </table>

    <p>{t.methodPercent(PERCENT_MIN_RESPONSES)}</p>

    <h2>{t.methodEditorial}</h2>
    <p>{t.methodEditorialWho}</p>
    <p>{t.methodEditorialInterests}</p>
    <p>{t.methodEditorialDate}</p>
  </div>
</Base>
