---
// The reveal. Party identity, quotes and source URLs are loaded here and only
// here — after the questionnaire is complete. Aggregate counters are fetched on
// this page too, for the same reason: showing them earlier is the conformity
// bias the product exists to remove.
//
// Everything displayed is known at build time, so it is rendered at build time
// (DT-07). What the script still does is what a build cannot know: which
// questions this reader answered, what they answered, and how the formations
// rank for them. Nothing is assembled from strings any more, so escaping is
// Astro's and the page is readable without JavaScript.
import Base from "../../layouts/Base.astro";
import Quote from "../../components/Quote.astro";
import Result from "../../components/Result.astro";
import Source from "../../components/Source.astro";
import questions from "../../../../content/questions/fr-2027.json";
import positions from "../../../../content/questions/fr-2027.positions.json";
import sources from "../../../../content/sources/fr-2027/sources.json";
import ensemble from "../../../../content/programs/fr-2027/ensemble.json";
import lr from "../../../../content/programs/fr-2027/lr.json";
import nfp from "../../../../content/programs/fr-2027/nfp.json";
import rn from "../../../../content/programs/fr-2027/rn.json";
import { API, href } from "../../lib/paths.js";
import { confidence, coverage } from "../../lib/score.js";
import { CHOICE_LABELS, CONFIDENCE_LABELS, LANGS, T, THEMES } from "../../lib/ui.js";

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
const t = T[lang];
const labels = CHOICE_LABELS[lang];

const programs = [ensemble, lr, nfp, rn];
const sourceById = Object.fromEntries(sources.map((source) => [source.id, source]));

// Flatten content into the shape the page renders and the client script needs,
// once, at build time.
const parties = Object.fromEntries(programs.map((p) => [p.party.id, p.party]));
const points = Object.fromEntries(
  programs.flatMap((program) =>
    program.points.map((point) => [
      point.id,
      { ...point, party: program.party.id, source: sourceById[program.source_id] },
    ]),
  ),
);
const byQuestion = Object.fromEntries(
  questions.questions.map((question) => [
    question.id,
    {
      text: question.text[lang],
      theme: THEMES[lang][question.theme],
      positions: (positions[question.id] ?? []).map((entry) => ({
        ...entry,
        ...points[entry.point],
      })),
    },
  ]),
);
const scoreInput = Object.fromEntries(
  Object.entries(positions).map(([id, entries]) => [
    id,
    entries.map((entry) => ({ party: points[entry.point].party, stance: entry.stance })),
  ]),
);

// Coverage, computed here at build: it depends on the corpus alone and on no
// answer, so no reader's browser has anything to work out (DP-12).
const total = questions.questions.length;
const covered = coverage(scoreInput);

// One sentence per possible comparison base, written by T: the plural rule lives
// in ui.js and is read here rather than restated, and the script rewrites no
// digit inside a sentence. The confidence sentence is fully determined by the
// base, so it is written whole; the fraction keeps one slot, `{n}`, for the
// agreed count. The levels come from score.js, where the bounds live and where
// the methodology page reads them too — never a second copy (DP-11, D7).
const fractions = Array.from({ length: total + 1 }, (_, base) => t.resultFraction(base));
const confidences = Array.from({ length: total + 1 }, (_, base) =>
  t.resultConfidence(CONFIDENCE_LABELS[lang][confidence(base)], base),
);

// Fingerprints are read from content/, never copied into web/ (INV-07, DT-12).
// Each file holds `<digest>  <url>`; the url is paired back against the source
// record, so a mismatched file fails the build instead of attesting the wrong
// document.
const digestFiles = import.meta.glob("../../../../content/sources/fr-2027/*.sha256", {
  query: "?raw",
  import: "default",
  eager: true,
});
const digests = Object.fromEntries(
  Object.entries(digestFiles).map(([path, text]) => [
    path.split("/").pop().replace(".sha256", ""),
    text.trim().split(/\s+/),
  ]),
);
const provenance = sources.map((source) => {
  const [digest, url] = digests[source.id] ?? [];
  if (url !== source.url) {
    throw new Error(`fingerprint for ${source.id} attests ${url ?? "nothing"}, not ${source.url}`);
  }
  return { source, digest };
});
---

<Base lang={lang} page="results" title={t.results}>
  <h1>{t.results}</h1>
  <p class="muted">{t.tagline}</p>

  {/* What the figures below rest on, before the first of them (DP-28, P4). One
      line per document: its exact title as the link, its publication date, and
      the fingerprint of the file that was read. Apparatus register — four
      documents set in reading size would be a wall before the reveal. Never
      collapsible, never dismissible, never after the results. */}
  <section class="provenance">
    <h2>{t.sources}</h2>
    <ul>
      {
        provenance.map(({ source, digest }) => (
          <li>
            <Source source={source} label={t.sourceLabel} />
            <span>{source.published ? t.published(source.published) : t.publishedUnknown}</span>
            {/* Shown abridged, copied whole: the element holds the 64 characters
                read from the file and nothing else — the label sits outside it,
                so a copy is the digest and not a sentence about it. */}
            <span>{t.fingerprint}</span>
            <code>{digest}</code>
          </li>
        ))
      }
    </ul>
  </section>

  {/* Every formation has its record here, whether anything was compared for it
      or not; the script fills them and moves them into fraction order. That
      order carries no rank marking: no numbering, no podium, no emphasis on the
      first (DP-10). */}
  <div id="ranking" aria-live="polite">
    <p id="no-answers" hidden>{t.noAnswers}</p>
    {
      Object.values(parties).map((party) => (
        <Result
          id={party.id}
          name={party.name}
          coverage={t.resultCoverage(covered[party.id] ?? 0, total)}
        />
      ))
    }
  </div>

  <h2>{t.detail}</h2>
  {/* Every question is rendered, answered or not. The page already holds the
      whole corpus in order to rank it, so rendering it costs nothing it was not
      already paying — and the proof, quote and document, becomes readable
      without JavaScript. The script hides what this reader did not answer. */}
  <div id="detail">
    {
      Object.entries(byQuestion).map(([id, question]) => (
        <details data-question={id}>
          <summary>{question.text}</summary>
          <p class="muted">
            <span class="theme">{question.theme}</span> · {t.yourAnswer} : <span class="answer" />
          </p>
          <ul>
            {question.positions.map((position) => (
              <li>
                <strong>{parties[position.party].name}</strong> —
                {position.stance === 1 ? t.supports : t.opposes}
                <Quote text={position.quote} />
                <Source source={position.source} label={t.sourceLabel} />
              </li>
            ))}
          </ul>
          {/* The counters are the one thing on this page that is not known at
              build time. Their labels are; only the figures wait, in elements
              that already exist. Hidden until they arrive, so nothing shows a
              row without its number. */}
          <div class="aggregate muted" data-question={id} hidden>
            <p>
              <strong>{t.aggregate}</strong>
            </p>
            {
              labels.map((label, choice) => (
                <p>
                  {label} — <span data-choice={choice} />%
                </p>
              ))
            }
          </div>
        </details>
      ))
    }
  </div>

  <p><a class="button" href={href(`${lang}/`)}>{t.restart}</a></p>

  {/* What is left for the script: the positions it scores, the scale labels for
      the answer given, the sentences indexed by comparison base, and the
      empty-counter message. Everything else on this page is rendered above and
      no longer travels. */}
  <script
    type="application/json"
    id="data"
    set:html={JSON.stringify({
      api: API,
      scoreInput,
      labels,
      fractions,
      confidences,
      aggregateEmpty: t.aggregateEmpty,
    })}></script>
</Base>

<script>
  import { CHOICES, score } from "../../lib/score.js";

  const data = JSON.parse(document.getElementById("data").textContent);
  const { scoreInput, labels, fractions, confidences } = data;
  const answers = JSON.parse(sessionStorage.getItem("civis:answers") ?? "{}");

  const ranking = document.getElementById("ranking");
  const rows = score(answers, scoreInput);

  // Every formation is revealed, compared or not: one with nothing to compare
  // states its reason in place of its fraction rather than disappearing
  // (INV-14). The message below is the passation-level case — no non-neutral
  // answer anywhere — and it withholds no result, since there is none to give.
  if (rows.every((row) => row.base === 0)) {
    document.getElementById("no-answers").hidden = false;
  }

  for (const row of rows) {
    const record = ranking.querySelector(`[data-party="${CSS.escape(row.party)}"]`);
    // The base decides the wording, so both sentences are read by base; the
    // agreed count is the only slot left to fill. No plural rule is restated
    // here, and no percentage is derived from the pair.
    record.querySelector(".fraction").textContent = fractions[row.base].replace("{n}", row.agreed);
    record.querySelector(".confidence").textContent = confidences[row.base];
    record.hidden = false;
    // Moved, not reordered by a layout property: document order stays the
    // order on screen, and so does the tab order (INV-17).
    ranking.append(record);
  }

  for (const item of document.querySelectorAll("#detail > details")) {
    const answer = answers[item.dataset.question];
    // The same rule as before: an answer is a numeric entry. A question without
    // one has nothing to compare, and is hidden rather than removed.
    if (typeof answer !== "number") {
      item.hidden = true;
      continue;
    }
    item.querySelector(".answer").textContent = labels[CHOICES.indexOf(answer)] ?? "";
  }

  // Aggregates arrive after the reveal, never before. A failure here is silent:
  // the questionnaire result does not depend on the counter service being up —
  // and a deployment without one simply has no aggregate section.
  if (!data.api) {
    for (const node of document.querySelectorAll(".aggregate")) node.remove();
  } else {
    fetch(`${data.api}/counts`)
      .then((response) => (response.ok ? response.json() : Promise.reject()))
      .then((counts) => {
        for (const node of document.querySelectorAll(".aggregate")) {
          const row = counts[node.dataset.question];
          const total = row?.reduce((sum, n) => sum + n, 0) ?? 0;
          if (!total) {
            node.textContent = data.aggregateEmpty;
          } else {
            for (const cell of node.querySelectorAll("[data-choice]")) {
              cell.textContent = String(Math.round((row[cell.dataset.choice] / total) * 100));
            }
          }
          node.hidden = false;
        }
      })
      .catch(() => {});
  }
</script>
