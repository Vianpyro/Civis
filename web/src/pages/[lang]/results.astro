---
// The reveal. Party identity, quotes and source URLs are loaded here and only
// here — after the questionnaire is complete. Aggregate counters are fetched on
// this page too, for the same reason: showing them earlier is the conformity
// bias the product exists to remove.
import Base from "../../layouts/Base.astro";
import questions from "../../../../content/questions/fr-2027.json";
import positions from "../../../../content/questions/fr-2027.positions.json";
import sources from "../../../../content/sources/fr-2027/sources.json";
import ensemble from "../../../../content/programs/fr-2027/ensemble.json";
import lr from "../../../../content/programs/fr-2027/lr.json";
import nfp from "../../../../content/programs/fr-2027/nfp.json";
import rn from "../../../../content/programs/fr-2027/rn.json";
import { API, href } from "../../lib/paths.js";
import { CHOICE_LABELS, LANGS, T, THEMES } from "../../lib/ui.js";

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
const t = T[lang];

const programs = [ensemble, lr, nfp, rn];
const sourceById = Object.fromEntries(sources.map((source) => [source.id, source]));

// Flatten content into the shape the client script needs, once, at build time.
const parties = Object.fromEntries(programs.map((p) => [p.party.id, p.party]));
const points = Object.fromEntries(
  programs.flatMap((program) =>
    program.points.map((point) => [
      point.id,
      { ...point, party: program.party.id, source: sourceById[program.source_id] },
    ]),
  ),
);
const byQuestion = Object.fromEntries(
  questions.questions.map((question) => [
    question.id,
    {
      text: question.text[lang],
      theme: THEMES[lang][question.theme],
      positions: (positions[question.id] ?? []).map((entry) => ({
        ...entry,
        ...points[entry.point],
      })),
    },
  ]),
);
const scoreInput = Object.fromEntries(
  Object.entries(positions).map(([id, entries]) => [
    id,
    entries.map((entry) => ({ party: points[entry.point].party, stance: entry.stance })),
  ]),
);
---

<Base lang={lang} page="results" title={t.results}>
  <h1>{t.results}</h1>
  <p class="muted">{t.tagline}</p>

  <div id="ranking" aria-live="polite"></div>

  <h2>{t.detail}</h2>
  <div id="detail"></div>

  <p><a class="button" href={href(`${lang}/`)}>{t.restart}</a></p>

  <script
    type="application/json"
    id="data"
    set:html={JSON.stringify({
      api: API,
      lang,
      parties,
      byQuestion,
      scoreInput,
      labels: CHOICE_LABELS[lang],
      t: {
        agreement: t.agreement,
        detail: t.detail,
        noAnswers: t.noAnswers,
        sourceLabel: t.sourceLabel,
        aggregate: t.aggregate,
        aggregateEmpty: t.aggregateEmpty,
        yourAnswer: t.yourAnswer,
        supports: t.supports,
        opposes: t.opposes,
        matchedOne: t.matched(1),
        matchedMany: t.matched(2),
      },
    })}></script>
</Base>

<script>
  import { score } from "../../lib/score.js";

  const data = JSON.parse(document.getElementById("data").textContent);
  const { parties, byQuestion, scoreInput, labels, t } = data;
  const answers = JSON.parse(sessionStorage.getItem("civis:answers") ?? "{}");
  const scale = [-1, -0.5, 0, 0.5, 1];

  const escape = (value) =>
    String(value).replace(
      /[&<>"]/g,
      (char) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" })[char],
    );

  const ranking = document.getElementById("ranking");
  const rows = score(answers, scoreInput);

  if (rows.length === 0) {
    ranking.innerHTML = `<p>${escape(t.noAnswers)}</p>`;
  } else {
    ranking.innerHTML = rows
      .map(({ party, agreement, matched }) => {
        const percent = Math.round(agreement * 100);
        const matchedLabel = (matched > 1 ? t.matchedMany : t.matchedOne).replace(
          /\d+/,
          String(matched),
        );
        return `<div class="result">
          <h3>${escape(parties[party].name)}</h3>
          <p class="muted" style="margin:.25rem 0 .5rem">
            <strong>${percent}%</strong> ${escape(t.agreement)} — ${escape(matchedLabel)}
          </p>
          <div class="bar"><span style="width:${percent}%"></span></div>
        </div>`;
      })
      .join("");
  }

  const detail = document.getElementById("detail");
  detail.innerHTML = Object.entries(byQuestion)
    .filter(([id]) => typeof answers[id] === "number")
    .map(([id, question]) => {
      const given = labels[scale.indexOf(answers[id])] ?? "";
      const stances = question.positions
        .map(
          (position) => `<li>
            <strong>${escape(parties[position.party].name)}</strong> —
            ${escape(position.stance === 1 ? t.supports : t.opposes)}
            <blockquote>« ${escape(position.quote)} »</blockquote>
            <a href="${escape(position.source.url)}" rel="noopener">
              ${escape(t.sourceLabel)} : ${escape(position.source.title)}</a>
          </li>`,
        )
        .join("");
      return `<details>
        <summary>${escape(question.text)}</summary>
        <p class="muted"><span class="theme">${escape(question.theme)}</span> ·
          ${escape(t.yourAnswer)} : ${escape(given)}</p>
        <ul>${stances}</ul>
        <div class="aggregate muted" data-question="${escape(id)}"></div>
      </details>`;
    })
    .join("");

  // Aggregates arrive after the reveal, never before. A failure here is silent:
  // the questionnaire result does not depend on the counter service being up —
  // and a deployment without one simply has no aggregate section.
  if (!data.api) {
    for (const node of document.querySelectorAll(".aggregate")) node.remove();
  } else {
    fetch(`${data.api}/counts`)
      .then((response) => (response.ok ? response.json() : Promise.reject()))
      .then((counts) => {
        for (const node of document.querySelectorAll(".aggregate")) {
          const row = counts[node.dataset.question];
          const total = row?.reduce((sum, n) => sum + n, 0) ?? 0;
          if (!total) {
            node.textContent = t.aggregateEmpty;
            continue;
          }
          node.innerHTML =
            `<p style="margin:.5rem 0 .25rem"><strong>${escape(t.aggregate)}</strong></p>` +
            row
              .map(
                (n, index) =>
                  `<p style="margin:.15rem 0">${escape(labels[index])} — ${Math.round(
                    (n / total) * 100,
                  )}%</p>`,
              )
              .join("");
        }
      })
      .catch(() => {});
  }
</script>
